<?xml version="1.0" encoding="UTF-8"?>
<!-- Benchmark runs are local only. Shared memory with a large segment and port queue so
     best-effort subscribers (Point-LIO, Super-LIO use SensorDataQoS) do not drop
     ~200 KB LiDAR scans that arrive together with IMU bursts. UDP is kept for discovery. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>liobench_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <port_queue_capacity>16384</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>liobench_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="liobench_local" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>liobench_shm</transport_id>
        <transport_id>liobench_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
