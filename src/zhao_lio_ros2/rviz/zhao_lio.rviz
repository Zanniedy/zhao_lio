Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 100
      Color: 160; 160; 164
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (accumulated scans)
      Enabled: true
      Topic:
        Value: /zhao_lio/cloud_world
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Decay Time: 10000
      Size (m): 0.05
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Value Bounds: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Current scan
      Enabled: true
      Topic:
        Value: /zhao_lio/cloud_world
        Depth: 5
        Reliability Policy: Reliable
      Decay Time: 0
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 255
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /zhao_lio/path
        Reliability Policy: Reliable
      Color: 255; 85; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /zhao_lio/odom
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Axes
        Axes Length: 1
        Axes Radius: 0.1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
  Global Options:
    Fixed Frame: odom
    Background Color: 30; 30; 30
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.9
      Yaw: 0.8
      Target Frame: <Fixed Frame>
